#!/bin/bash
set -e  # exit on first error

# Parse command line arguments
TARGET_ENV=""
ENABLE_TUNNEL=true
DOCKER_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env=*)
      TARGET_ENV="${1#*=}"
      shift
      ;;
    --env)
      if [[ -n "$2" && "$2" != --* ]]; then
        TARGET_ENV="$2"
        shift 2
      else
        echo "Error: Argument --env requires a value (e.g. --env local or --env production)."
        exit 1
      fi
      ;;
    --no-tunnel)
      ENABLE_TUNNEL=false
      shift
      ;;
    -h|--help)
      echo "Usage: ./start --env <local|production> [options] [docker compose options]"
      echo ""
      echo "Options:"
      echo "  --env <env>    Target environment (local, production)"
      echo "  --no-tunnel    Disable Cloudflare tunnel (only applies to local environment)"
      echo "  -h, --help     Show this help message"
      echo ""
      echo "Examples:"
      echo "  ./start --env local"
      echo "  ./start --env local --no-tunnel"
      echo "  ./start --env local --build"
      echo "  ./start --env production --build --force-recreate"
      exit 0
      ;;
    --)
      shift
      DOCKER_ARGS+=("$@")
      break
      ;;
    *)
      DOCKER_ARGS+=("$1")
      shift
      ;;
  esac
done

# Require --env before executing anything
if [ -z "$TARGET_ENV" ]; then
  echo "Error: The --env parameter is required before executing anything."
  echo "Usage: ./start --env <local|production> [options] [docker compose options]"
  exit 1
fi

# Cleanup on exit
cleanup() {
  if [ -f ".cloudflared.pid" ]; then
    CF_PID=$(cat .cloudflared.pid 2>/dev/null || true)
    if [ -n "$CF_PID" ] && kill -0 "$CF_PID" 2>/dev/null; then
      echo "Stopping Cloudflare tunnel (PID: $CF_PID)..."
      kill "$CF_PID" 2>/dev/null || true
    fi
    rm -f .cloudflared.pid
  fi
}
trap cleanup EXIT INT TERM

# Check if .env file exists
if [ ! -f .env ]; then
  echo "Error: .env file does not exist!"
  echo "Please create your .env file before running this script."
  echo "You can initialize one by copying the example file:"
  echo "  cp .env.example .env"
  exit 1
fi

# Load nvm if available
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Use correct Node version (from .nvmrc if exists, or default to 22)
if command -v nvm &> /dev/null; then
  nvm use 22 || true
fi

# Check if APP_ENV in .env differs from passed target env
DOTENV_ENV=$(grep -E '^APP_ENV=' .env | cut -d '=' -f2 | tr -d ' "\r')
if [ -n "$DOTENV_ENV" ] && [ "$DOTENV_ENV" != "$TARGET_ENV" ]; then
  echo "Notice: APP_ENV in .env is '$DOTENV_ENV', while running with target --env='$TARGET_ENV'."
fi

# Check if vendor directory exists (e.g. freshly cloned repository)
if [ ! -d "vendor" ]; then
  echo "Vendor directory not found. Installing composer dependencies..."
  if [ "$TARGET_ENV" = "production" ] || [ "$TARGET_ENV" = "prod" ]; then
    docker compose -f docker-compose-prod.yml run --rm --no-deps laravel.app composer install --no-dev --prefer-dist --optimize-autoloader
  else
    docker compose run --rm --no-deps laravel.app composer install --prefer-dist
  fi
fi

if [ ${#DOCKER_ARGS[@]} -gt 0 ]; then
  echo "Starting backend ($TARGET_ENV mode) with docker options: ${DOCKER_ARGS[*]}..."
else
  echo "Starting backend ($TARGET_ENV mode)..."
fi

if [ "$TARGET_ENV" = "production" ] || [ "$TARGET_ENV" = "prod" ]; then
  if [ -f "docker-compose-prod.yml" ]; then
    docker compose -f docker-compose-prod.yml up -d "${DOCKER_ARGS[@]}"
  else
    vendor/bin/sail up -d "${DOCKER_ARGS[@]}"
  fi

  echo "Installing frontend dependencies..."
  if command -v npm &> /dev/null; then
    npm install
    echo "Building frontend for production..."
    npm run build
  else
    echo "Host npm not found, installing and building frontend inside docker container..."
    docker compose -f docker-compose-prod.yml exec -T laravel.app npm install
    docker compose -f docker-compose-prod.yml exec -T laravel.app npm run build
  fi

  echo "Production environment is ready and running."
else
  vendor/bin/sail up -d "${DOCKER_ARGS[@]}"

  # Start Cloudflare Tunnel for local environment by default
  if [ "$ENABLE_TUNNEL" = true ]; then
    if command -v cloudflared &> /dev/null; then
      # Stop any existing tunnel tracked in pidfile
      if [ -f ".cloudflared.pid" ]; then
        OLD_PID=$(cat .cloudflared.pid 2>/dev/null || true)
        if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
          echo "Stopping previous Cloudflare tunnel (PID: $OLD_PID)..."
          kill "$OLD_PID" 2>/dev/null || true
        fi
        rm -f .cloudflared.pid
      fi

      APP_PORT_VAL=$(grep -E '^APP_PORT=' .env | cut -d '=' -f2 | tr -d ' "\r')
      APP_PORT_VAL=${APP_PORT_VAL:-80}
      echo "Starting Cloudflare tunnel for local environment (http://localhost:$APP_PORT_VAL)..."
      rm -f .cloudflared.log

      CF_TOKEN=$(grep -E '^CLOUDFLARE_TUNNEL_TOKEN=' .env | cut -d '=' -f2 | tr -d ' "\r')
      if [ -n "$CF_TOKEN" ]; then
        nohup cloudflared tunnel run --token "$CF_TOKEN" --no-autoupdate > .cloudflared.log 2>&1 &
      else
        nohup cloudflared tunnel --url "http://localhost:$APP_PORT_VAL" --no-autoupdate > .cloudflared.log 2>&1 &
      fi

      CF_PID=$!
      echo "$CF_PID" > .cloudflared.pid

      echo "Waiting for Cloudflare tunnel URL..."
      TUNNEL_URL=""
      for i in {1..20}; do
        if [ -f .cloudflared.log ]; then
          TUNNEL_URL=$(grep -o 'https://[a-zA-Z0-9.-]*\.trycloudflare\.com' .cloudflared.log | head -n 1 || true)
          if [ -n "$TUNNEL_URL" ]; then
            break
          fi
        fi
        sleep 1
      done

      if [ -n "$TUNNEL_URL" ]; then
        echo "================================================================="
        echo "🌐 Cloudflare Tunnel connected: $TUNNEL_URL"
        echo "================================================================="

        # Automatically update Telegram Bot webhook if token configured
        BOT_TOKEN=$(grep -E '^TELEGRAM_BOT_TOKEN=' .env | cut -d '=' -f2 | tr -d ' "\r')
        if [ -n "$BOT_TOKEN" ]; then
          echo "Setting Telegram webhook to: $TUNNEL_URL/api/telegram/webhook..."
          for attempt in {1..5}; do
            sleep 2
            if ./vendor/bin/sail artisan telegram:set-webhook "$TUNNEL_URL/api/telegram/webhook" > /dev/null 2>&1; then
              echo "✅ Telegram webhook updated successfully!"
              break
            else
              echo "Waiting for Cloudflare DNS propagation (attempt $attempt/5)..."
            fi
          done
        fi
      else
        echo "⚠️ Cloudflare tunnel process started (PID: $CF_PID), but URL detection timed out. Check .cloudflared.log."
      fi
    else
      echo "Notice: 'cloudflared' command not found. Cloudflare tunnel skipped."
      echo "To enable, install via: brew install cloudflared"
    fi
  fi

  echo "Installing frontend dependencies..."
  npm install

  echo "Starting frontend in development mode..."
  npm run dev
fi